<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        Player-only styles (Android player/PlayerScreen.kt). Self-contained because the controls layer lives in
        LibVLCSharp's overlay window, outside the main window's resource tree. Flat surfaces, no gradients.
    -->
    <FontFamily x:Key="P.Font">pack://application:,,,/Assets/Fonts/#Inter</FontFamily>
    <FontFamily x:Key="P.Serif">pack://application:,,,/Assets/Fonts/#Fraunces 9pt, pack://application:,,,/Assets/Fonts/#Fraunces, Georgia</FontFamily>
    <FontFamily x:Key="P.Mono">Consolas, Cascadia Mono, Courier New</FontFamily>

    <SolidColorBrush x:Key="P.Amber" Color="#E8A33D" />
    <SolidColorBrush x:Key="P.AmberSoft" Color="#F3C77F" />
    <SolidColorBrush x:Key="P.AmberDim" Color="#3A2B14" />
    <SolidColorBrush x:Key="P.OnAmber" Color="#1B1206" />
    <SolidColorBrush x:Key="P.Text" Color="#F3EFE6" />
    <SolidColorBrush x:Key="P.Muted" Color="#9C9AA3" />
    <SolidColorBrush x:Key="P.Faint" Color="#6B6973" />
    <SolidColorBrush x:Key="P.Surface" Color="#15151A" />
    <SolidColorBrush x:Key="P.SurfaceHigh" Color="#1E1E25" />
    <SolidColorBrush x:Key="P.SurfaceHigh85" Color="#D91E1E25" />
    <SolidColorBrush x:Key="P.SurfaceHighest" Color="#26262F" />
    <SolidColorBrush x:Key="P.Outline" Color="#2C2C35" />
    <SolidColorBrush x:Key="P.OutlineStrong" Color="#3B3B46" />
    <SolidColorBrush x:Key="P.Danger" Color="#FF6B5E" />
    <SolidColorBrush x:Key="P.Exit" Color="#D63B30" />
    <SolidColorBrush x:Key="P.Chrome" Color="#8C000000" />
    <SolidColorBrush x:Key="P.White10" Color="#1AFFFFFF" />
    <SolidColorBrush x:Key="P.White18" Color="#2EFFFFFF" />
    <SolidColorBrush x:Key="P.White24" Color="#3DFFFFFF" />
    <SolidColorBrush x:Key="P.HitTest" Color="#01000000" />

