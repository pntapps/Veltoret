    <Style x:Key="P.Icon" TargetType="Path">
        <Setter Property="Stretch" Value="Uniform" />
        <Setter Property="Fill" Value="{Binding Path=(TextElement.Foreground), RelativeSource={RelativeSource Self}}" />
        <Setter Property="IsHitTestVisible" Value="False" />
    </Style>

    <Style x:Key="P.TextBase" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource P.Font}" />
        <Setter Property="Foreground" Value="{StaticResource P.Text}" />
        <Setter Property="FontSize" Value="14" />
    </Style>

    <!-- Round chrome button: 44 px, white 10 % fill, icon ~52 % of the size. -->
    <Style x:Key="P.Round" TargetType="Button">
        <Setter Property="Width" Value="44" />
        <Setter Property="Height" Value="44" />
        <Setter Property="Foreground" Value="{StaticResource P.Text}" />
        <Setter Property="Background" Value="{StaticResource P.White10}" />
        <Setter Property="Padding" Value="11" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="999">
                        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource P.White24}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The play/pause button: amber circle. -->
    <Style x:Key="P.RoundAccent" TargetType="Button" BasedOn="{StaticResource P.Round}">
        <Setter Property="Background" Value="{StaticResource P.Amber}" />
        <Setter Property="Foreground" Value="{StaticResource P.OnAmber}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="999">
                        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource P.AmberSoft}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Tool chips: 40 px high, radius 12, white 10 % fill; Tag="accent" for the amber one. -->
    <Style x:Key="P.Chip" TargetType="Button">
        <Setter Property="Height" Value="40" />
        <Setter Property="Foreground" Value="{StaticResource P.Text}" />
        <Setter Property="Background" Value="{StaticResource P.White10}" />
        <Setter Property="FontFamily" Value="{StaticResource P.Font}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="Margin" Value="0,0,8,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="12" Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Opacity" Value="0.85" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="P.ChipAccent" TargetType="Button" BasedOn="{StaticResource P.Chip}">
        <Setter Property="Background" Value="{StaticResource P.Amber}" />
        <Setter Property="Foreground" Value="{StaticResource P.OnAmber}" />
    </Style>
    <!-- Exit: a red chip, easy to find and to hit with a finger. -->
    <Style x:Key="P.ChipExit" TargetType="Button" BasedOn="{StaticResource P.Chip}">
        <Setter Property="Background" Value="{StaticResource P.Exit}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Margin" Value="8,0,0,0" />
    </Style>
    <Style x:Key="P.ChipOutline" TargetType="Button" BasedOn="{StaticResource P.Chip}">
        <Setter Property="Background" Value="{StaticResource P.SurfaceHighest}" />
    </Style>

    <!-- A row in a side panel. -->
    <Style x:Key="P.Row" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource P.Text}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="20,12" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="12">
                        <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource P.White10}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="P.Scroll" TargetType="ScrollViewer">
        <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="Focusable" Value="False" />
    </Style>
</ResourceDictionary>
