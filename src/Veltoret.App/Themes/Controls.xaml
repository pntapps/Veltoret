    <!-- ===================== Scroll bars (thin, dark, implicit) ===================== -->
    <Style x:Key="ScrollBar.Thumb" TargetType="Thumb">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="b" Background="{StaticResource Brush.OutlineStrong}" CornerRadius="3" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="{StaticResource Brush.TextFaint}" /></Trigger>
                        <Trigger Property="IsDragging" Value="True"><Setter TargetName="b" Property="Background" Value="{StaticResource Brush.TextMuted}" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="ScrollBar.Page" TargetType="RepeatButton">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton"><Border Background="Transparent" /></ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ScrollBar">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Width" Value="10" />
        <Setter Property="MinWidth" Value="10" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Border Background="{TemplateBinding Background}" Padding="2">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton><RepeatButton Style="{StaticResource ScrollBar.Page}" Command="ScrollBar.PageUpCommand" /></Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton><RepeatButton Style="{StaticResource ScrollBar.Page}" Command="ScrollBar.PageDownCommand" /></Track.IncreaseRepeatButton>
                            <Track.Thumb><Thumb Style="{StaticResource ScrollBar.Thumb}" MinHeight="32" /></Track.Thumb>
                        </Track>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Height" Value="10" />
                <Setter Property="MinHeight" Value="10" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Border Background="{TemplateBinding Background}" Padding="2">
                                <Track x:Name="PART_Track" IsDirectionReversed="False">
                                    <Track.DecreaseRepeatButton><RepeatButton Style="{StaticResource ScrollBar.Page}" Command="ScrollBar.PageLeftCommand" /></Track.DecreaseRepeatButton>
                                    <Track.IncreaseRepeatButton><RepeatButton Style="{StaticResource ScrollBar.Page}" Command="ScrollBar.PageRightCommand" /></Track.IncreaseRepeatButton>
                                    <Track.Thumb><Thumb Style="{StaticResource ScrollBar.Thumb}" MinWidth="32" /></Track.Thumb>
                                </Track>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="ScrollViewer" TargetType="ScrollViewer">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollViewer">
                    <Grid Background="{TemplateBinding Background}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <ScrollContentPresenter x:Name="PART_ScrollContentPresenter" Grid.ColumnSpan="2" Grid.RowSpan="2"
                                                CanContentScroll="{TemplateBinding CanContentScroll}" Margin="{TemplateBinding Padding}" />
                        <!-- Bars overlay the content (no layout jump), like Android. -->
                        <ScrollBar x:Name="PART_VerticalScrollBar" Grid.Column="1" Orientation="Vertical" Opacity="0.85"
                                   Value="{TemplateBinding VerticalOffset}" Maximum="{TemplateBinding ScrollableHeight}"
                                   ViewportSize="{TemplateBinding ViewportHeight}"
                                   Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}" />
                        <ScrollBar x:Name="PART_HorizontalScrollBar" Grid.Row="1" Orientation="Horizontal" Opacity="0.85"
                                   Value="{TemplateBinding HorizontalOffset}" Maximum="{TemplateBinding ScrollableWidth}"
                                   ViewportSize="{TemplateBinding ViewportWidth}"
                                   Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ScrollViewer" BasedOn="{StaticResource ScrollViewer}" />

    <!-- ===================== Buttons ===================== -->
    <Style x:Key="FocusVisual.Rounded">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="-3" CornerRadius="14" BorderThickness="2" BorderBrush="{StaticResource Brush.AmberHalf}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Button.Base" TargetType="ButtonBase">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual.Rounded}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontFamily" Value="{StaticResource Font.Sans}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="MinHeight" Value="48" />
        <Setter Property="Padding" Value="20,12" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="c:Motion.PressScale" Value="0.97" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ButtonBase">
                    <Grid SnapsToDevicePixels="True">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12" />
                        <Border x:Name="hover" Background="{StaticResource Brush.Hover}" CornerRadius="12" Visibility="Collapsed" />
                        <Border Padding="{TemplateBinding Padding}">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                        VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                                <c:Spinner x:Name="spin" Width="18" Height="18" Thickness="2" Margin="0,0,10,0" Visibility="Collapsed"
                                           Stroke="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}" />
                                <c:Icon x:Name="icon" Size="20" Margin="0,0,8,0"
                                        Data="{Binding (c:ButtonAssist.Icon), RelativeSource={RelativeSource TemplatedParent}}"
                                        Foreground="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}"
                                        Visibility="{Binding (c:ButtonAssist.Icon), RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static c:Converters.VisibleIfNotNull}}" />
                                <ContentPresenter x:Name="cp" RecognizesAccessKey="True" VerticalAlignment="Center"
                                                  TextElement.Foreground="{TemplateBinding Foreground}">
                                    <ContentPresenter.Resources>
                                        <Style TargetType="TextBlock"><Setter Property="TextTrimming" Value="CharacterEllipsis" /></Style>
                                    </ContentPresenter.Resources>
                                </ContentPresenter>
                            </StackPanel>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="c:ButtonAssist.IsLoading" Value="True">
                            <Setter TargetName="spin" Property="Visibility" Value="Visible" />
                            <Setter TargetName="icon" Property="Visibility" Value="Collapsed" />
                            <Setter Property="IsHitTestVisible" Value="False" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="hover" Property="Visibility" Value="Visible" /></Trigger>
                        <Trigger Property="Content" Value="{x:Null}"><Setter TargetName="icon" Property="Margin" Value="0" /></Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Background" Value="{StaticResource Brush.SurfaceHigh}" />
                            <Setter Property="BorderBrush" Value="{StaticResource Brush.Outline}" />
                            <Setter Property="Foreground" Value="{StaticResource Brush.TextFaint}" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Button.Primary" TargetType="ButtonBase" BasedOn="{StaticResource Button.Base}">
        <Setter Property="Background" Value="{StaticResource Brush.Amber}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Amber}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.OnAmber}" />
    </Style>
    <Style x:Key="Button.Secondary" TargetType="ButtonBase" BasedOn="{StaticResource Button.Base}">
        <Setter Property="Background" Value="{StaticResource Brush.SurfaceHigh}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.OutlineStrong}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
    </Style>
    <Style x:Key="Button.Ghost" TargetType="ButtonBase" BasedOn="{StaticResource Button.Base}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Outline}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
    </Style>
    <Style x:Key="Button.Danger" TargetType="ButtonBase" BasedOn="{StaticResource Button.Base}">
        <Setter Property="Background" Value="{StaticResource Brush.Danger}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Danger}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.OnAmber}" />
    </Style>
    <!-- Text button: amber label, 8×6 padding, corner 8 hit area ("See all", "Restore"). -->
    <Style x:Key="Button.Text" TargetType="ButtonBase">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual.Rounded}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontFamily" Value="{StaticResource Font.Sans}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Amber}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ButtonBase">
                    <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <c:Spinner x:Name="spin" Width="16" Height="16" Thickness="2" Margin="0,0,8,0" Visibility="Collapsed"
                                       Stroke="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}" />
                            <c:Icon x:Name="icon" Size="18" Margin="0,0,8,0" 
                                    Data="{Binding (c:ButtonAssist.Icon), RelativeSource={RelativeSource TemplatedParent}}" Visibility="{Binding (c:ButtonAssist.Icon), RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static c:Converters.VisibleIfNotNull}}" />
                            <ContentPresenter RecognizesAccessKey="True" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" />
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="c:ButtonAssist.IsLoading" Value="True">
                            <Setter TargetName="spin" Property="Visibility" Value="Visible" />
                            <Setter Property="IsHitTestVisible" Value="False" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="{StaticResource Brush.Hover}" /></Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="bd" Property="Background" Value="{StaticResource Brush.Pressed}" /></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{StaticResource Brush.TextFaint}" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Button.TextMuted" TargetType="ButtonBase" BasedOn="{StaticResource Button.Text}">
        <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}" />
    </Style>

    <!-- Round icon button (VIconButton): 42 px circle, SurfaceHigh + hairline; Content = c:Icon / Path / glyph. -->
    <Style x:Key="Button.Icon" TargetType="ButtonBase">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Width" Value="42" />
        <Setter Property="Height" Value="42" />
        <Setter Property="FontFamily" Value="{StaticResource Font.Icons}" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
        <Setter Property="Background" Value="{StaticResource Brush.SurfaceHigh}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Outline}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="c:Motion.PressScale" Value="0.94" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ButtonBase">
                    <Grid>
                        <Ellipse x:Name="disc" Fill="{TemplateBinding Background}" Stroke="{TemplateBinding BorderBrush}"
                                 StrokeThickness="{Binding BorderThickness.Left, RelativeSource={RelativeSource TemplatedParent}}" />
                        <Ellipse x:Name="hover" Fill="{StaticResource Brush.Hover}" Visibility="Collapsed" />
                        <Ellipse x:Name="focus" Stroke="{StaticResource Brush.Amber}" StrokeThickness="2" Visibility="Collapsed" />
                        <c:Icon x:Name="icon" HorizontalAlignment="Center" VerticalAlignment="Center" 
                                Size="{Binding (c:ButtonAssist.IconSize), RelativeSource={RelativeSource TemplatedParent}}"
                                Data="{Binding (c:ButtonAssist.Icon), RelativeSource={RelativeSource TemplatedParent}}" Visibility="{Binding (c:ButtonAssist.Icon), RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static c:Converters.VisibleIfNotNull}}"
                                Foreground="{TemplateBinding Foreground}" />
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="hover" Property="Visibility" Value="Visible" /></Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="focus" Property="Visibility" Value="Visible" /></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Button.IconOnImage" TargetType="ButtonBase" BasedOn="{StaticResource Button.Icon}">
        <Setter Property="Background" Value="{StaticResource Brush.ImageDim}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <!-- Small borderless round icon button (close "×" in lists, trailing icons). -->
    <Style x:Key="Button.IconFlat" TargetType="ButtonBase" BasedOn="{StaticResource Button.Icon}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="c:ButtonAssist.IconSize" Value="16" />
        <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}" />
    </Style>
    <!-- No chrome: a clickable area (cards, rows). Content decides the look. -->
    <Style x:Key="Button.Plain" TargetType="ButtonBase">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual.Rounded}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ButtonBase">
                    <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- Clickable row with a corner-14 hover highlight (episode rows, choice rows, folder rows). -->
    <Style x:Key="Button.Row" TargetType="ButtonBase">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual.Rounded}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ButtonBase">
                    <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="14" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="{StaticResource Brush.Hover}" /></Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="bd" Property="Background" Value="{StaticResource Brush.Pressed}" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- SelectChip: height 36, corner 10, padding 14 h. -->
    <Style x:Key="Chip" TargetType="ToggleButton">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual.Rounded}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Height" Value="36" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="FontFamily" Value="{StaticResource Font.Sans}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
        <Setter Property="Background" Value="{StaticResource Brush.Surface}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Outline}" />
        <Setter Property="c:Motion.PressScale" Value="0.97" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                            CornerRadius="10" Padding="{TemplateBinding Padding}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <c:Icon x:Name="icon" Size="16" Margin="0,0,6,0"  Fill="{StaticResource Brush.TextMuted}"
                                    Data="{Binding (c:ButtonAssist.Icon), RelativeSource={RelativeSource TemplatedParent}}" Visibility="{Binding (c:ButtonAssist.Icon), RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static c:Converters.VisibleIfNotNull}}" />
                            <ContentPresenter VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" />
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{StaticResource Brush.SurfaceHigh}" /></Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter Property="Background" Value="{StaticResource Brush.AmberDim}" />
                            <Setter Property="BorderBrush" Value="{StaticResource Brush.Amber60}" />
                            <Setter Property="Foreground" Value="{StaticResource Brush.AmberSoft}" />
                            <Setter TargetName="icon" Property="Fill" Value="{StaticResource Brush.AmberSoft}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== Text input (VTextField: corner 12, Surface, Outline → Amber when focused) ===================== -->
    <Style x:Key="TextBox" TargetType="TextBox">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="FontFamily" Value="{StaticResource Font.Sans}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
        <Setter Property="CaretBrush" Value="{StaticResource Brush.Amber}" />
        <Setter Property="SelectionBrush" Value="{StaticResource Brush.Amber}" />
        <Setter Property="Background" Value="{StaticResource Brush.Surface}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Outline}" />
        <Setter Property="MinHeight" Value="52" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="12">
                        <Grid Margin="{TemplateBinding Padding}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <c:Icon x:Name="icon" Size="20" Margin="0,0,12,0" VerticalAlignment="Center"  Fill="{StaticResource Brush.TextMuted}"
                                    Data="{Binding (c:ButtonAssist.Icon), RelativeSource={RelativeSource TemplatedParent}}" Visibility="{Binding (c:ButtonAssist.Icon), RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static c:Converters.VisibleIfNotNull}}" />
                            <TextBlock x:Name="hint" Grid.Column="1" VerticalAlignment="Center" Margin="2,0,0,0" Foreground="{StaticResource Brush.TextFaint}"
                                       Text="{TemplateBinding c:ButtonAssist.Placeholder}" Visibility="Collapsed" IsHitTestVisible="False" TextTrimming="CharacterEllipsis" />
                            <ScrollViewer x:Name="PART_ContentHost" Grid.Column="1" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" Focusable="False" />
                            <ContentPresenter Grid.Column="2" Content="{TemplateBinding Tag}" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value=""><Setter TargetName="hint" Property="Visibility" Value="Visible" /></Trigger>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Brush.OutlineStrong}" /></Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Brush.Amber}" />
                            <Setter TargetName="icon" Property="Fill" Value="{StaticResource Brush.Amber}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="TextBox" BasedOn="{StaticResource TextBox}" />

    <Style x:Key="PasswordBox" TargetType="PasswordBox">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="FontFamily" Value="{StaticResource Font.Sans}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
        <Setter Property="CaretBrush" Value="{StaticResource Brush.Amber}" />
        <Setter Property="SelectionBrush" Value="{StaticResource Brush.Amber}" />
        <Setter Property="Background" Value="{StaticResource Brush.Surface}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Outline}" />
        <Setter Property="MinHeight" Value="52" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="c:ButtonAssist.TrackPassword" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="PasswordBox">
                    <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="12">
                        <Grid Margin="{TemplateBinding Padding}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <c:Icon x:Name="icon" Size="20" Margin="0,0,12,0" VerticalAlignment="Center"  Fill="{StaticResource Brush.TextMuted}"
                                    Data="{Binding (c:ButtonAssist.Icon), RelativeSource={RelativeSource TemplatedParent}}" Visibility="{Binding (c:ButtonAssist.Icon), RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static c:Converters.VisibleIfNotNull}}" />
                            <TextBlock x:Name="hint" Grid.Column="1" VerticalAlignment="Center" Margin="2,0,0,0" Foreground="{StaticResource Brush.TextFaint}"
                                       Text="{TemplateBinding c:ButtonAssist.Placeholder}" Visibility="Collapsed" IsHitTestVisible="False" />
                            <ScrollViewer x:Name="PART_ContentHost" Grid.Column="1" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" Focusable="False" />
                            <ContentPresenter Grid.Column="2" Content="{TemplateBinding Tag}" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="c:ButtonAssist.IsEmpty" Value="True"><Setter TargetName="hint" Property="Visibility" Value="Visible" /></Trigger>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Brush.OutlineStrong}" /></Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Brush.Amber}" />
                            <Setter TargetName="icon" Property="Fill" Value="{StaticResource Brush.Amber}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="PasswordBox" BasedOn="{StaticResource PasswordBox}" />

    <!-- ===================== Menus (Material DropdownMenu: SurfaceHigh container) ===================== -->
    <Style x:Key="ContextMenu" TargetType="ContextMenu">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="FontFamily" Value="{StaticResource Font.Sans}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border Background="{StaticResource Brush.SurfaceHigh}" BorderBrush="{StaticResource Brush.Outline}" BorderThickness="1"
                            CornerRadius="10" Padding="0,6" MinWidth="200">
                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ContextMenu" BasedOn="{StaticResource ContextMenu}" />

    <Style x:Key="MenuItem" TargetType="MenuItem">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontFamily" Value="{StaticResource Font.Sans}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="bd" Background="Transparent" Padding="14,10" MinHeight="44">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <c:Icon x:Name="icon" Size="20" Margin="0,0,14,0" VerticalAlignment="Center" Foreground="{StaticResource Brush.TextMuted}"
                                    Data="{TemplateBinding c:ButtonAssist.Icon}" Visibility="{Binding (c:ButtonAssist.Icon), RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static c:Converters.VisibleIfNotNull}}" />
                            <ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center" />
                            <Popup x:Name="PART_Popup" Placement="Right" IsOpen="{TemplateBinding IsSubmenuOpen}" AllowsTransparency="True" Focusable="False">
                                <Border Background="{StaticResource Brush.SurfaceHigh}" BorderBrush="{StaticResource Brush.Outline}" BorderThickness="1" CornerRadius="10" Padding="0,6">
                                    <StackPanel IsItemsHost="True" />
                                </Border>
                            </Popup>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="bd" Property="Background" Value="{StaticResource Brush.SurfaceHighest}" /></Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource Brush.Amber}" />
                            <Setter TargetName="icon" Property="Foreground" Value="{StaticResource Brush.Amber}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{StaticResource Brush.TextFaint}" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="MenuItem" BasedOn="{StaticResource MenuItem}" />
    <Style TargetType="Separator" x:Key="{x:Static MenuItem.SeparatorStyleKey}">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator"><Border Height="1" Margin="0,4" Background="{StaticResource Brush.Outline}" /></ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- Caption inside a menu ("SOURCE"): a disabled MenuItem with this style. -->
    <Style x:Key="MenuItem.Caption" TargetType="MenuItem">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <TextBlock Text="{TemplateBinding Header}" Margin="12,6,12,2" Style="{StaticResource Text.LabelSmall}" Foreground="{StaticResource Brush.TextMuted}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ToolTip">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{StaticResource Brush.SurfaceHighest}" BorderBrush="{StaticResource Brush.Outline}" BorderThickness="1" CornerRadius="6" Padding="8,4">
                        <ContentPresenter TextElement.Foreground="{StaticResource Brush.Text}" TextElement.FontFamily="{StaticResource Font.Sans}" TextElement.FontSize="12" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== ComboBox ===================== -->
    <Style x:Key="ComboBoxItem" TargetType="ComboBoxItem">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="bd" Background="Transparent" Padding="14,10">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="bd" Property="Background" Value="{StaticResource Brush.SurfaceHighest}" /></Trigger>
                        <Trigger Property="IsSelected" Value="True"><Setter Property="Foreground" Value="{StaticResource Brush.Amber}" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ComboBoxItem" BasedOn="{StaticResource ComboBoxItem}" />
    <Style x:Key="ComboBox" TargetType="ComboBox">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontFamily" Value="{StaticResource Font.Sans}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
        <Setter Property="Background" Value="{StaticResource Brush.Surface}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Outline}" />
        <Setter Property="MinHeight" Value="44" />
        <Setter Property="Padding" Value="14,0,10,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton x:Name="toggle" Focusable="False" ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="bd" Background="{Binding Background, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                            BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=ComboBox}}" BorderThickness="1" CornerRadius="12">
                                        <c:Icon Data="{StaticResource Icon.ExpandMore}" Size="20" HorizontalAlignment="Right" Margin="0,0,10,0" Foreground="{StaticResource Brush.TextMuted}" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Brush.OutlineStrong}" /></Trigger>
                                        <Trigger Property="IsChecked" Value="True"><Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Brush.Amber}" /></Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <ContentPresenter IsHitTestVisible="False" Margin="{TemplateBinding Padding}" Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" VerticalAlignment="Center" HorizontalAlignment="Left" />
                        <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                            <Border Background="{StaticResource Brush.SurfaceHigh}" BorderBrush="{StaticResource Brush.Outline}" BorderThickness="1" CornerRadius="10"
                                    Padding="0,6" Margin="0,4,0,0" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                    MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                <ScrollViewer><StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" /></ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ComboBox" BasedOn="{StaticResource ComboBox}" />

    <!-- ===================== CheckBox / Toggle switch ===================== -->
    <Style x:Key="CheckBox" TargetType="CheckBox">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontFamily" Value="{StaticResource Font.Sans}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Border x:Name="box" Width="20" Height="20" CornerRadius="5" BorderThickness="2" BorderBrush="{StaticResource Brush.OutlineStrong}" Background="Transparent" VerticalAlignment="Center">
                            <c:Icon x:Name="check" Data="{StaticResource Icon.Check}" Size="16" Foreground="{StaticResource Brush.OnAmber}" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ContentPresenter Margin="12,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="box" Property="Background" Value="{StaticResource Brush.Amber}" />
                            <Setter TargetName="box" Property="BorderBrush" Value="{StaticResource Brush.Amber}" />
                            <Setter TargetName="check" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="box" Property="BorderBrush" Value="{StaticResource Brush.Amber}" /></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="CheckBox" BasedOn="{StaticResource CheckBox}" />

    <!-- Switch (Material Switch): 52×32 track; checked = Amber track, OnAmber thumb. -->
    <Style x:Key="Toggle" TargetType="ToggleButton">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid Width="52" Height="32" Background="Transparent">
                        <Border x:Name="track" CornerRadius="16" BorderThickness="2" BorderBrush="{StaticResource Brush.OutlineStrong}" Background="{StaticResource Brush.SurfaceHigh}" />
                        <Ellipse x:Name="thumb" Width="16" Height="16" Fill="{StaticResource Brush.TextMuted}" HorizontalAlignment="Left" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="track" Property="Background" Value="{StaticResource Brush.Amber}" />
                            <Setter TargetName="track" Property="BorderBrush" Value="{StaticResource Brush.Amber}" />
                            <Setter TargetName="thumb" Property="Fill" Value="{StaticResource Brush.OnAmber}" />
                            <Setter TargetName="thumb" Property="Width" Value="24" />
                            <Setter TargetName="thumb" Property="Height" Value="24" />
                            <Setter TargetName="thumb" Property="Margin" Value="24,0,0,0" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="track" Property="BorderBrush" Value="{StaticResource Brush.AmberSoft}" /></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== ProgressBar (VProgress: 3 px, rounded, Amber on Outline) ===================== -->
    <Style x:Key="ProgressBar" TargetType="ProgressBar">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Height" Value="3" />
        <Setter Property="Minimum" Value="0" />
        <Setter Property="Maximum" Value="1" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Amber}" />
        <Setter Property="Background" Value="{StaticResource Brush.Outline}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid>
                        <Border x:Name="PART_Track" Background="{TemplateBinding Background}"
                                CornerRadius="{Binding ActualHeight, RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static c:Converters.HalfRadius}}" />
                        <Border x:Name="PART_Indicator" HorizontalAlignment="Left" Background="{TemplateBinding Foreground}"
                                CornerRadius="{Binding ActualHeight, RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static c:Converters.HalfRadius}}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ProgressBar" BasedOn="{StaticResource ProgressBar}" />

    <!-- ===================== Slider ===================== -->
    <Style x:Key="Slider.Thumb" TargetType="Thumb">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Grid Width="20" Height="20" Background="Transparent">
                        <Ellipse x:Name="e" Width="14" Height="14" Fill="{StaticResource Brush.Amber}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="e" Property="Width" Value="18" /><Setter TargetName="e" Property="Height" Value="18" /></Trigger>
                        <Trigger Property="IsDragging" Value="True"><Setter TargetName="e" Property="Width" Value="18" /><Setter TargetName="e" Property="Height" Value="18" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Slider.Fill" TargetType="RepeatButton">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Grid Background="Transparent"><Border Height="4" CornerRadius="2" Background="{TemplateBinding Background}" /></Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Slider" TargetType="Slider">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="IsMoveToPointEnabled" Value="True" />
        <Setter Property="MinHeight" Value="24" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Track x:Name="PART_Track" VerticalAlignment="Center">
                        <Track.DecreaseRepeatButton><RepeatButton Style="{StaticResource Slider.Fill}" Background="{StaticResource Brush.Amber}" Command="Slider.DecreaseLarge" /></Track.DecreaseRepeatButton>
                        <Track.IncreaseRepeatButton><RepeatButton Style="{StaticResource Slider.Fill}" Background="{StaticResource Brush.OutlineStrong}" Command="Slider.IncreaseLarge" /></Track.IncreaseRepeatButton>
                        <Track.Thumb><Thumb Style="{StaticResource Slider.Thumb}" /></Track.Thumb>
                    </Track>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="Slider" BasedOn="{StaticResource Slider}" />

    <!-- ===================== ListBox items ===================== -->
    <Style x:Key="ListItem" TargetType="ListBoxItem">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="12,10" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="bd" Background="Transparent" CornerRadius="14" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="{StaticResource Brush.Hover}" /></Trigger>
                        <Trigger Property="IsSelected" Value="True"><Setter TargetName="bd" Property="Background" Value="{StaticResource Brush.AmberDim}" /><Setter Property="Foreground" Value="{StaticResource Brush.AmberSoft}" /></Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="bd" Property="Background" Value="{StaticResource Brush.SurfaceHigh}" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- ListBox with no chrome (used as a plain virtualizing items host). -->
    <Style x:Key="ListBox.Plain" TargetType="ListBox">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource ListItem}" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBox">
                    <ScrollViewer Padding="{TemplateBinding Padding}" CanContentScroll="{TemplateBinding ScrollViewer.CanContentScroll}" Focusable="False">
                        <ItemsPresenter />
                    </ScrollViewer>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== Surfaces ===================== -->
    <!-- Card / Panel: CardShape 14, Surface, 1 px Outline, padding 16. -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Brush.Surface}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Outline}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>
    <Style x:Key="Panel" TargetType="Border" BasedOn="{StaticResource Card}" />
    <Style x:Key="Divider" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Brush.Outline}" />
        <Setter Property="Height" Value="1" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>
    <Style x:Key="Divider.Vertical" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Brush.Outline}" />
        <Setter Property="Width" Value="1" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- Pill (badge): corner 6, padding 7×3, 1 px border; text uppercased labelSmall (Text.Pill). -->
    <Style x:Key="Pill" TargetType="Border">
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="7,3" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.OutlineStrong}" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="TextElement.Foreground" Value="{StaticResource Brush.Text}" />
    </Style>
    <Style x:Key="Pill.Solid" TargetType="Border" BasedOn="{StaticResource Pill}">
        <Setter Property="Background" Value="{StaticResource Brush.PillSolid}" />
    </Style>
    <Style x:Key="Pill.Accent" TargetType="Border" BasedOn="{StaticResource Pill}">
        <Setter Property="Background" Value="{StaticResource Brush.AmberDim}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.AmberHalf}" />
        <Setter Property="TextElement.Foreground" Value="{StaticResource Brush.AmberSoft}" />
    </Style>
    <Style x:Key="Text.Pill" TargetType="TextBlock" BasedOn="{StaticResource Text.LabelSmall}">
        <Setter Property="Foreground" Value="{Binding (TextElement.Foreground), RelativeSource={RelativeSource AncestorType=Border}}" />
        <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>

    <!-- Text helpers -->
    <Style x:Key="Text.Muted" TargetType="TextBlock" BasedOn="{StaticResource Text.BodySmall}">
        <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}" />
    </Style>
    <Style x:Key="Text.OneLine" TargetType="TextBlock" BasedOn="{StaticResource Text.TitleSmall}">
        <Setter Property="TextWrapping" Value="NoWrap" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
</ResourceDictionary>
