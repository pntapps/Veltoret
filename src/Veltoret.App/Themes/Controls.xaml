<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="clr-namespace:Veltoret.App.Controls">
    <!--
        Shared control styles (Android: ui/components/Components.kt). Flat surfaces, 1 px hairlines, amber accent.
        No gradients. Corner radii: buttons/text fields 12, chips 10, cards/panels 14, posters 12, pills 6.

        Buttons:  Button.Primary (amber), Button.Secondary (surface + hairline), Button.Ghost (outline only),
                  Button.Text (amber label), Button.TextMuted, Button.Icon (42 px circle; Content = c:Icon/Path/glyph),
                  Button.IconOnImage (60% black disc, no border), Button.Plain (no chrome; for clickable cards).
                  c:ButtonAssist.Icon adds a 20 px icon before the label; c:ButtonAssist.IsLoading shows a spinner.
        Inputs:   TextBox, PasswordBox (c:ButtonAssist.Placeholder = hint), ComboBox, CheckBox, Toggle (switch),
                  Chip (ToggleButton; c:ButtonAssist.Icon optional), Slider, ProgressBar.
        Lists:    ListItem (ListBoxItem), MenuItem / ContextMenu (implicit too), Divider (Border), Card / Panel (Border),
                  Pill / Pill.Accent / Pill.Solid (Border) with Text.Pill.
        Icons:    Geometry resources "Icon.*" (24×24), drawn with c:Icon.
    -->

    <FontFamily x:Key="Font.Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
    <FontFamily x:Key="Font.Mono">Cascadia Mono, Consolas</FontFamily>
    <CornerRadius x:Key="Radius.Button">12</CornerRadius>
    <CornerRadius x:Key="Radius.Chip">10</CornerRadius>
    <CornerRadius x:Key="Radius.Card">14</CornerRadius>
    <CornerRadius x:Key="Radius.Poster">12</CornerRadius>
    <CornerRadius x:Key="Radius.Pill">6</CornerRadius>
    <SolidColorBrush x:Key="Brush.PillSolid" Color="#D90B0B0D" />
    <SolidColorBrush x:Key="Brush.AmberHalf" Color="#80E8A33D" />
    <SolidColorBrush x:Key="Brush.Amber60" Color="#99E8A33D" />
    <SolidColorBrush x:Key="Brush.Hover" Color="#0FFFFFFF" />
    <SolidColorBrush x:Key="Brush.Pressed" Color="#1AFFFFFF" />
    <SolidColorBrush x:Key="Brush.Danger45" Color="#73FF6B5E" />

