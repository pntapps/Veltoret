<Window x:Class="Veltoret.App.Player.PlayerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
        xmlns:c="clr-namespace:Veltoret.App.Controls"
        Title="Veltoret" Width="1280" Height="760" MinWidth="320" MinHeight="180"
        Background="Black" WindowStartupLocation="CenterScreen" UseLayoutRounding="True">
    <Grid Background="Black">
        <vlc:VideoView x:Name="Video" Background="Black">
            <!-- Controls layer. LibVLCSharp shows this content in a transparent window over the video (airspace),
                 so it carries its own resources and a near-transparent fill to receive the mouse. -->
            <Grid x:Name="Overlay" Background="#01000000" ClipToBounds="True" TextElement.FontFamily="pack://application:,,,/Assets/Fonts/#Inter">
                <Grid.Resources>
                    <ResourceDictionary Source="/Veltoret;component/Player/PlayerStyles.xaml" />
                </Grid.Resources>

                <!-- Double-click seek feedback ("10 seconds"). -->
                <Border x:Name="RippleLeft" HorizontalAlignment="Left" VerticalAlignment="Center" Background="{StaticResource P.White10}"
                        CornerRadius="0,999,999,0" Opacity="0" IsHitTestVisible="False">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Path Data="{StaticResource P.Icon.Rewind}" Fill="{StaticResource P.Text}" Width="34" Height="34" Stretch="Uniform" />
                        <TextBlock x:Name="RippleLeftText" Style="{StaticResource P.TextBase}" FontWeight="SemiBold" Margin="0,6,0,0" HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>
                <Border x:Name="RippleRight" HorizontalAlignment="Right" VerticalAlignment="Center" Background="{StaticResource P.White10}"
                        CornerRadius="999,0,0,999" Opacity="0" IsHitTestVisible="False">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Path Data="{StaticResource P.Icon.Forward}" Fill="{StaticResource P.Text}" Width="34" Height="34" Stretch="Uniform" />
                        <TextBlock x:Name="RippleRightText" Style="{StaticResource P.TextBase}" FontWeight="SemiBold" Margin="0,6,0,0" HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>

                <!-- Controls (scrim + top bar + transport + timeline). -->
                <Grid x:Name="Chrome" Background="{StaticResource P.Chrome}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Top bar -->
                    <DockPanel x:Name="TopBar" Grid.Row="0" Margin="16,14,16,0" LastChildFill="True">
                        <Button x:Name="BackButton" DockPanel.Dock="Left" Style="{StaticResource P.Round}" ToolTip="Back" Click="OnBackClick">
                            <Path Style="{StaticResource P.Icon}" Data="{StaticResource P.Icon.Back}" />
                        </Button>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <ContentControl x:Name="CastButtonHost" x:FieldModifier="public" Margin="8,0,0,0" VerticalAlignment="Center" Focusable="False" />
                            <Button x:Name="EpisodesButton" Style="{StaticResource P.Round}" Margin="8,0,0,0" ToolTip="Episodes" Click="OnEpisodesClick">
                                <Path Style="{StaticResource P.Icon}" Data="{StaticResource P.Icon.Episodes}" />
                            </Button>
                            <Button x:Name="PipButton" Style="{StaticResource P.Round}" Margin="8,0,0,0" ToolTip="Picture in picture" Click="OnPipClick">
                                <Path Style="{StaticResource P.Icon}" Data="{StaticResource P.Icon.Pip}" />
                            </Button>
                            <Button x:Name="LockButton" Style="{StaticResource P.Round}" Margin="8,0,0,0" ToolTip="Lock controls" Click="OnLockClick">
                                <Path Style="{StaticResource P.Icon}" Data="{StaticResource P.Icon.LockOpen}" />
                            </Button>
                            <Button x:Name="MoreButton" Style="{StaticResource P.Round}" Margin="8,0,0,0" ToolTip="More" Click="OnMoreClick">
                                <Path Style="{StaticResource P.Icon}" Data="{StaticResource P.Icon.More}" />
                            </Button>
                        </StackPanel>
                        <StackPanel Margin="14,0,8,0" VerticalAlignment="Center">
                            <TextBlock x:Name="TitleText" Style="{StaticResource P.TextBase}" FontFamily="{StaticResource P.Serif}" FontSize="19"
                                       FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="SubtitleText" Style="{StaticResource P.TextBase}" FontSize="13" Foreground="{StaticResource P.Muted}"
                                       TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                        </StackPanel>
                    </DockPanel>

                    <!-- Centre transport -->
                    <StackPanel x:Name="Transport" Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Button x:Name="PrevButton" Style="{StaticResource P.Round}" Width="50" Height="50" Padding="13" ToolTip="Previous episode" Click="OnPreviousClick">
                            <Path Style="{StaticResource P.Icon}" Data="{StaticResource P.Icon.Previous}" />
                        </Button>
                        <Border x:Name="PrevSpacer" Width="50" Height="50" />
                        <Button x:Name="SeekBackButton" Style="{StaticResource P.Round}" Width="58" Height="58" Padding="15" Margin="32,0,0,0" Click="OnSeekBackClick">
                            <Path Style="{StaticResource P.Icon}" Data="{StaticResource P.Icon.Rewind}" />
                        </Button>
                        <Button x:Name="PlayButton" Style="{StaticResource P.RoundAccent}" Width="78" Height="78" Padding="20" Margin="32,0,0,0" Click="OnPlayClick"
                                ToolTip="Pause">
                            <Grid>
                                <Path x:Name="PlayIcon" Style="{StaticResource P.Icon}" Data="{StaticResource P.Icon.Pause}" />
                                <c:Spinner x:Name="PlaySpinner" Width="34" Height="34" Thickness="3" Stroke="{StaticResource P.OnAmber}" Visibility="Collapsed" />
                            </Grid>
                        </Button>
                        <Button x:Name="SeekForwardButton" Style="{StaticResource P.Round}" Width="58" Height="58" Padding="15" Margin="32,0,0,0" Click="OnSeekForwardClick">
                            <Path Style="{StaticResource P.Icon}" Data="{StaticResource P.Icon.Forward}" />
                        </Button>
                        <Button x:Name="NextButton" Style="{StaticResource P.Round}" Width="50" Height="50" Padding="13" Margin="32,0,0,0" ToolTip="Next episode" Click="OnNextClick">
                            <Path Style="{StaticResource P.Icon}" Data="{StaticResource P.Icon.Next}" />
                        </Button>
                        <Border x:Name="NextSpacer" Width="50" Height="50" Margin="32,0,0,0" />
                    </StackPanel>

                    <!-- Bottom: timeline + tools -->
                    <StackPanel Grid.Row="2" Margin="20,0,20,16" Tag="ui">
                        <TextBlock x:Name="EndsAtText" Style="{StaticResource P.TextBase}" FontSize="12" Foreground="{StaticResource P.Muted}"
                                   HorizontalAlignment="Right" Margin="0,0,0,2" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" MinWidth="56" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" MinWidth="56" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="PositionText" Grid.Column="0" Style="{StaticResource P.TextBase}" FontFamily="{StaticResource P.Mono}" FontSize="13"
                                       VerticalAlignment="Center" Text="0:00" />
                            <Grid x:Name="SeekArea" Grid.Column="1" Height="36" Margin="12,0" Background="{StaticResource P.HitTest}" Cursor="Hand" Tag="ui"
                                  MouseLeftButtonDown="OnSeekDown" MouseMove="OnSeekMove" MouseLeftButtonUp="OnSeekUp" LostMouseCapture="OnSeekLostCapture">
                                <Border x:Name="SeekTrack" Height="4" CornerRadius="3" Background="{StaticResource P.White18}" VerticalAlignment="Center" />
                                <Border x:Name="SeekPlayed" Height="4" CornerRadius="3" Background="{StaticResource P.Amber}" VerticalAlignment="Center"
                                        HorizontalAlignment="Left" Width="0" />
                                <Ellipse x:Name="SeekThumb" Width="16" Height="16" Fill="{StaticResource P.Amber}" HorizontalAlignment="Left" VerticalAlignment="Center" />
                            </Grid>
                            <TextBlock x:Name="RemainingText" Grid.Column="2" Style="{StaticResource P.TextBase}" FontFamily="{StaticResource P.Mono}" FontSize="13"
                                       VerticalAlignment="Center" HorizontalAlignment="Right" Text="--:--" />
                        </Grid>
                        <DockPanel Margin="0,6,0,0" LastChildFill="True">
                            <Button x:Name="ExitChip" DockPanel.Dock="Right" Style="{StaticResource P.ChipExit}" ToolTip="Close the player" Click="OnBackClick">
                                <StackPanel Orientation="Horizontal">
                                    <Path Style="{StaticResource P.Icon}" Data="{StaticResource P.Icon.Close}" Width="18" Height="18" Margin="0,0,8,0" />
                                    <TextBlock Text="Exit" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="NextChip" DockPanel.Dock="Right" Style="{StaticResource P.ChipAccent}" Margin="8,0,0,0" Click="OnNextClick">
                                <StackPanel Orientation="Horizontal">
                                    <Path Style="{StaticResource P.Icon}" Data="{StaticResource P.Icon.Next}" Width="18" Height="18" Margin="0,0,8,0" />
                                    <TextBlock Text="Next episode" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" Focusable="False">
                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="AudioChip" Style="{StaticResource P.Chip}" Click="OnAudioClick">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Style="{StaticResource P.Icon}" Data="{StaticResource P.Icon.Audio}" Width="18" Height="18" Margin="0,0,8,0" />
                                            <TextBlock Text="Audio" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="SubtitlesChip" Style="{StaticResource P.Chip}" Click="OnSubtitlesClick">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Style="{StaticResource P.Icon}" Data="{StaticResource P.Icon.Subtitles}" Width="18" Height="18" Margin="0,0,8,0" />
                                            <TextBlock Text="Subtitles" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="SpeedChip" Style="{StaticResource P.Chip}" Click="OnSpeedClick">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Style="{StaticResource P.Icon}" Data="{StaticResource P.Icon.Speed}" Width="18" Height="18" Margin="0,0,8,0" />
                                            <TextBlock x:Name="SpeedChipText" Text="Speed" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="AspectChip" Style="{StaticResource P.Chip}" Click="OnAspectClick">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Style="{StaticResource P.Icon}" Data="{StaticResource P.Icon.Aspect}" Width="18" Height="18" Margin="0,0,8,0" />
                                            <TextBlock x:Name="AspectChipText" Text="Fit" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="FullscreenChip" Style="{StaticResource P.Chip}" Click="OnFullscreenClick">
                                        <StackPanel Orientation="Horizontal">
                                            <Path x:Name="FullscreenChipIcon" Style="{StaticResource P.Icon}" Data="{StaticResource P.Icon.Fullscreen}" Width="18" Height="18" Margin="0,0,8,0" />
                                            <TextBlock x:Name="FullscreenChipText" Text="Full screen" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="HdrChip" Style="{StaticResource P.Chip}" Click="OnHdrClick" Visibility="Collapsed">
                                        <StackPanel Orientation="Horizontal">
                                            <!-- Green dot: HDR is on (the chip is amber then too). -->
                                            <Ellipse x:Name="HdrOnDot" Width="9" Height="9" Fill="{StaticResource P.On}" Stroke="{StaticResource P.OnAmber}" StrokeThickness="1"
                                                     VerticalAlignment="Center" Margin="0,0,8,0" Visibility="Collapsed" />
                                            <Path x:Name="HdrChipIcon" Style="{StaticResource P.Icon}" Data="{StaticResource P.Icon.Hdr}" Width="18" Height="18" Margin="0,0,8,0" />
                                            <TextBlock x:Name="HdrChipText" Text="HDR" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="SkipChip" Style="{StaticResource P.Chip}" Click="OnSkipChipClick">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Style="{StaticResource P.Icon}" Data="{StaticResource P.Icon.Forward}" Width="18" Height="18" Margin="0,0,8,0" />
                                            <TextBlock x:Name="SkipChipText" Text="+85s" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </ScrollViewer>
                        </DockPanel>
                    </StackPanel>
                </Grid>

                <!-- Locked: only "Unlock". -->
                <Button x:Name="UnlockButton" Style="{StaticResource P.Round}" Width="52" Height="52" Padding="14" HorizontalAlignment="Left" VerticalAlignment="Center"
                        Margin="32,0,0,0" ToolTip="Unlock" Visibility="Collapsed" Click="OnUnlockClick">
                    <Path Style="{StaticResource P.Icon}" Data="{StaticResource P.Icon.Lock}" />
                </Button>

                <!-- Loading while controls are hidden, and the slow-loading hint. -->
                <c:Spinner x:Name="CenterSpinner" Width="52" Height="52" Thickness="3" Stroke="{StaticResource P.Amber}" Visibility="Collapsed"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                <Border x:Name="LoadingHint" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,150,0,0" CornerRadius="10"
                        Background="{StaticResource P.SurfaceHigh85}" Padding="14,6" Visibility="Collapsed" IsHitTestVisible="False">
                    <TextBlock x:Name="LoadingHintText" Style="{StaticResource P.TextBase}" />
                </Border>

                <!-- HUD pill (volume, zoom, notices, 2× speed). -->
                <Border x:Name="Hud" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,48,0,0" CornerRadius="999"
                        Background="{StaticResource P.Chrome}" Padding="16,9" Opacity="0" IsHitTestVisible="False">
                    <StackPanel Orientation="Horizontal">
                        <Path x:Name="HudIcon" Fill="{StaticResource P.Amber}" Width="18" Height="18" Stretch="Uniform" Margin="0,0,10,0" VerticalAlignment="Center" />
                        <TextBlock x:Name="HudText" Style="{StaticResource P.TextBase}" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <!-- "Resumed at 12:34" + "Start over". -->
                <Border x:Name="ResumeCard" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="24,0,0,28" CornerRadius="16"
                        Background="{StaticResource P.SurfaceHigh85}" BorderBrush="{StaticResource P.Outline}" BorderThickness="1" Padding="16,10,10,10"
                        Visibility="Collapsed" Tag="ui">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="ResumeText" Style="{StaticResource P.TextBase}" VerticalAlignment="Center" Margin="0,0,12,0" />
                        <Button Style="{StaticResource P.ChipOutline}" Margin="0" Height="34" Click="OnStartOverClick">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource P.Icon}" Data="{StaticResource P.Icon.Replay}" Width="16" Height="16" Margin="0,0,6,0" />
                                <TextBlock Text="Start over" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- Skip intro -->
                <Button x:Name="SkipIntroButton" Style="{StaticResource P.ChipAccent}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,28,28"
                        Visibility="Collapsed" Click="OnSkipIntroClick" Height="44">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource P.Icon}" Data="{StaticResource P.Icon.Forward}" Width="18" Height="18" Margin="0,0,8,0" />
                        <TextBlock Text="Skip intro" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <!-- Up next -->
                <Border x:Name="UpNextCard" Width="300" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,24,24" CornerRadius="18"
                        Background="{StaticResource P.SurfaceHigh}" BorderBrush="{StaticResource P.Outline}" BorderThickness="1" Padding="16"
                        Visibility="Collapsed" Tag="ui">
                    <StackPanel>
                        <TextBlock Text="UP NEXT" Style="{StaticResource P.TextBase}" Foreground="{StaticResource P.Amber}" FontSize="11" FontWeight="Bold" />
                        <TextBlock x:Name="UpNextLabel" Style="{StaticResource P.TextBase}" FontSize="15" FontWeight="SemiBold" Margin="0,6,0,12"
                                   TextWrapping="Wrap" MaxHeight="44" TextTrimming="CharacterEllipsis" />
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="UpNextPlay" Style="{StaticResource P.ChipAccent}" Click="OnNextClick">
                                <StackPanel Orientation="Horizontal">
                                    <Path Style="{StaticResource P.Icon}" Data="{StaticResource P.Icon.Play}" Width="16" Height="16" Margin="0,0,6,0" />
                                    <TextBlock x:Name="UpNextPlayText" Text="Play now" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="UpNextCancel" Style="{StaticResource P.ChipOutline}" Click="OnUpNextCancelClick">
                                <StackPanel Orientation="Horizontal">
                                    <Path Style="{StaticResource P.Icon}" Data="{StaticResource P.Icon.Pause}" Width="16" Height="16" Margin="0,0,6,0" />
                                    <TextBlock Text="Cancel" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Error card -->
                <Border x:Name="ErrorCard" MaxWidth="440" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24" CornerRadius="20"
                        Background="{StaticResource P.SurfaceHigh}" BorderBrush="{StaticResource P.Outline}" BorderThickness="1" Padding="24"
                        Visibility="Collapsed" Tag="ui">
                    <StackPanel>
                        <TextBlock Text="Playback stopped" Style="{StaticResource P.TextBase}" FontFamily="{StaticResource P.Serif}" FontSize="22" FontWeight="SemiBold" />
                        <TextBlock x:Name="ErrorText" Style="{StaticResource P.TextBase}" Foreground="{StaticResource P.Muted}" TextWrapping="Wrap" Margin="0,10,0,18" LineHeight="21" />
                        <WrapPanel HorizontalAlignment="Right">
                            <Button Style="{StaticResource P.ChipOutline}" Click="OnBackClick" Margin="0,4,8,0">
                                <StackPanel Orientation="Horizontal">
                                    <Path Style="{StaticResource P.Icon}" Data="{StaticResource P.Icon.Back}" Width="16" Height="16" Margin="0,0,6,0" />
                                    <TextBlock Text="Close" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="TrySoftwareButton" Style="{StaticResource P.ChipOutline}" Click="OnTrySoftwareClick" Margin="0,4,8,0">
                                <TextBlock Text="Try software" VerticalAlignment="Center" />
                            </Button>
                            <Button Style="{StaticResource P.ChipAccent}" Click="OnRetryClick" Margin="0,4,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <Path Style="{StaticResource P.Icon}" Data="{StaticResource P.Icon.Play}" Width="16" Height="16" Margin="0,0,6,0" />
                                    <TextBlock Text="Retry" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- Side panel (Audio, Subtitles, Speed, Episodes, More, Sleep timer, Video info). -->
                <Grid x:Name="PanelLayer" Visibility="Collapsed" Tag="ui">
                    <Border x:Name="PanelScrim" Background="#66000000" MouseLeftButtonDown="OnPanelScrimDown" />
                    <Border x:Name="PanelBox" Width="400" HorizontalAlignment="Right" Background="{StaticResource P.Surface}"
                            BorderBrush="{StaticResource P.Outline}" BorderThickness="1,0,0,0">
                        <DockPanel>
                            <DockPanel DockPanel.Dock="Top" Margin="20,18,12,8">
                                <Button DockPanel.Dock="Right" Style="{StaticResource P.Round}" Width="36" Height="36" Padding="10" ToolTip="Close" Click="OnPanelCloseClick">
                                    <Path Style="{StaticResource P.Icon}" Data="{StaticResource P.Icon.Close}" />
                                </Button>
                                <Button x:Name="PanelBackButton" DockPanel.Dock="Left" Style="{StaticResource P.Round}" Width="36" Height="36" Padding="10"
                                        Margin="-8,0,8,0" ToolTip="Back" Visibility="Collapsed" Click="OnPanelBackClick">
                                    <Path Style="{StaticResource P.Icon}" Data="{StaticResource P.Icon.Back}" />
                                </Button>
                                <TextBlock x:Name="PanelTitle" Style="{StaticResource P.TextBase}" FontFamily="{StaticResource P.Serif}" FontSize="20"
                                           FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            </DockPanel>
                            <ScrollViewer x:Name="PanelScroll" Style="{StaticResource P.Scroll}" Padding="8,0,8,16">
                                <StackPanel x:Name="PanelContent" />
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                </Grid>

                <!-- Mini player controls (shown on hover). -->
                <Grid x:Name="MiniControls" Background="{StaticResource P.Chrome}" Visibility="Collapsed" Opacity="0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="6">
                        <Button Style="{StaticResource P.Round}" Width="32" Height="32" Padding="8" ToolTip="Expand" Click="OnMiniExpandClick">
                            <Path Style="{StaticResource P.Icon}" Data="{StaticResource P.Icon.Expand}" />
                        </Button>
                        <Button Style="{StaticResource P.Round}" Width="32" Height="32" Padding="9" Margin="6,0,0,0" ToolTip="Close" Click="OnBackClick">
                            <Path Style="{StaticResource P.Icon}" Data="{StaticResource P.Icon.Close}" />
                        </Button>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Button Style="{StaticResource P.Round}" ToolTip="Back 10 seconds" Click="OnMiniBackClick">
                            <Path Style="{StaticResource P.Icon}" Data="{StaticResource P.Icon.Rewind}" />
                        </Button>
                        <Button x:Name="MiniPlayButton" Style="{StaticResource P.RoundAccent}" Width="52" Height="52" Padding="14" Margin="16,0" ToolTip="Pause" Click="OnPlayClick">
                            <Path x:Name="MiniPlayIcon" Style="{StaticResource P.Icon}" Data="{StaticResource P.Icon.Pause}" />
                        </Button>
                        <Button Style="{StaticResource P.Round}" ToolTip="Forward 10 seconds" Click="OnMiniForwardClick">
                            <Path Style="{StaticResource P.Icon}" Data="{StaticResource P.Icon.Forward}" />
                        </Button>
                    </StackPanel>
                    <Border x:Name="MiniProgress" Height="3" VerticalAlignment="Bottom" HorizontalAlignment="Left" Background="{StaticResource P.Amber}" Width="0" />
                </Grid>
            </Grid>
        </vlc:VideoView>
    </Grid>
</Window>
