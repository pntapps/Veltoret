<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        Veltoret design tokens (Android: ui/theme/Color.kt and Type.kt). Depth comes from layered flat surfaces and
        hairline outlines: the design language never uses gradients (the only exception is TMDB's unmodified logo).
        Page backgrounds use the DynamicResource "Brush.Background" so "Pure black" can swap it; never hard-code it.
    -->

    <!-- Colors -->
    <Color x:Key="Color.Background">#FF0B0B0D</Color>
    <Color x:Key="Color.BackgroundOled">#FF000000</Color>
    <Color x:Key="Color.Surface">#FF15151A</Color>
    <Color x:Key="Color.SurfaceHigh">#FF1E1E25</Color>
    <Color x:Key="Color.SurfaceHighest">#FF26262F</Color>
    <Color x:Key="Color.Outline">#FF2C2C35</Color>
    <Color x:Key="Color.OutlineStrong">#FF3B3B46</Color>
    <Color x:Key="Color.Text">#FFF3EFE6</Color>
    <Color x:Key="Color.TextMuted">#FF9C9AA3</Color>
    <Color x:Key="Color.TextFaint">#FF6B6973</Color>
    <Color x:Key="Color.Amber">#FFE8A33D</Color>
    <Color x:Key="Color.AmberSoft">#FFF3C77F</Color>
    <Color x:Key="Color.AmberDim">#FF3A2B14</Color>
    <Color x:Key="Color.OnAmber">#FF1B1206</Color>
    <Color x:Key="Color.Danger">#FFFF6B5E</Color>
    <Color x:Key="Color.Success">#FF6FCF97</Color>
    <!-- Flat (single-tone) dim used when anything must sit on top of imagery. -->
    <Color x:Key="Color.ImageDim">#99000000</Color>
    <!-- Stronger flat dim for full-screen backdrops that carry titles and rows on top. -->
    <Color x:Key="Color.BackdropDim">#B8000000</Color>
    <Color x:Key="Color.PlayerChrome">#8C000000</Color>

    <!-- Brushes -->
    <SolidColorBrush x:Key="Brush.Background" Color="{StaticResource Color.Background}" />
    <SolidColorBrush x:Key="Brush.Surface" Color="{StaticResource Color.Surface}" />
    <SolidColorBrush x:Key="Brush.SurfaceHigh" Color="{StaticResource Color.SurfaceHigh}" />
    <SolidColorBrush x:Key="Brush.SurfaceHighest" Color="{StaticResource Color.SurfaceHighest}" />
    <SolidColorBrush x:Key="Brush.Outline" Color="{StaticResource Color.Outline}" />
    <SolidColorBrush x:Key="Brush.OutlineStrong" Color="{StaticResource Color.OutlineStrong}" />
    <SolidColorBrush x:Key="Brush.Text" Color="{StaticResource Color.Text}" />
    <SolidColorBrush x:Key="Brush.TextMuted" Color="{StaticResource Color.TextMuted}" />
    <SolidColorBrush x:Key="Brush.TextFaint" Color="{StaticResource Color.TextFaint}" />
    <SolidColorBrush x:Key="Brush.Amber" Color="{StaticResource Color.Amber}" />
    <SolidColorBrush x:Key="Brush.AmberSoft" Color="{StaticResource Color.AmberSoft}" />
    <SolidColorBrush x:Key="Brush.AmberDim" Color="{StaticResource Color.AmberDim}" />
    <SolidColorBrush x:Key="Brush.OnAmber" Color="{StaticResource Color.OnAmber}" />
    <SolidColorBrush x:Key="Brush.Danger" Color="{StaticResource Color.Danger}" />
    <SolidColorBrush x:Key="Brush.Success" Color="{StaticResource Color.Success}" />
    <SolidColorBrush x:Key="Brush.ImageDim" Color="{StaticResource Color.ImageDim}" />
    <SolidColorBrush x:Key="Brush.BackdropDim" Color="{StaticResource Color.BackdropDim}" />
    <SolidColorBrush x:Key="Brush.PlayerChrome" Color="{StaticResource Color.PlayerChrome}" />

    <!-- Fonts: Fraunces for titles, Inter for everything else (both SIL OFL 1.1, third_party/fonts/OFL.txt). -->
    <!-- The bundled variable Fraunces registers with WPF as "Fraunces 9pt" (its default instance); "#Fraunces" doesn't resolve. -->
    <FontFamily x:Key="Font.Serif">pack://application:,,,/Assets/Fonts/#Fraunces 9pt, pack://application:,,,/Assets/Fonts/#Fraunces, Georgia</FontFamily>
    <FontFamily x:Key="Font.Sans">pack://application:,,,/Assets/Fonts/#Inter</FontFamily>

    <!-- Type scale (sizes in px = Android sp). -->
    <Style x:Key="Text.DisplayLarge" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Serif}" />
        <Setter Property="FontSize" Value="48" /><Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="LineHeight" Value="54" /><Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="Text.DisplayMedium" TargetType="TextBlock" BasedOn="{StaticResource Text.DisplayLarge}">
        <Setter Property="FontSize" Value="38" /><Setter Property="LineHeight" Value="44" />
    </Style>
    <Style x:Key="Text.DisplaySmall" TargetType="TextBlock" BasedOn="{StaticResource Text.DisplayLarge}">
        <Setter Property="FontSize" Value="30" /><Setter Property="LineHeight" Value="36" />
    </Style>
    <Style x:Key="Text.HeadlineLarge" TargetType="TextBlock" BasedOn="{StaticResource Text.DisplayLarge}">
        <Setter Property="FontSize" Value="28" /><Setter Property="LineHeight" Value="34" />
    </Style>
    <Style x:Key="Text.HeadlineMedium" TargetType="TextBlock" BasedOn="{StaticResource Text.DisplayLarge}">
        <Setter Property="FontSize" Value="24" /><Setter Property="LineHeight" Value="30" />
    </Style>
    <Style x:Key="Text.HeadlineSmall" TargetType="TextBlock" BasedOn="{StaticResource Text.DisplayLarge}">
        <Setter Property="FontSize" Value="20" /><Setter Property="LineHeight" Value="26" />
    </Style>
    <Style x:Key="Text.TitleLarge" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Sans}" />
        <Setter Property="FontSize" Value="19" /><Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="LineHeight" Value="26" /><Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="Text.TitleMedium" TargetType="TextBlock" BasedOn="{StaticResource Text.TitleLarge}">
        <Setter Property="FontSize" Value="16" /><Setter Property="LineHeight" Value="22" />
    </Style>
    <Style x:Key="Text.TitleSmall" TargetType="TextBlock" BasedOn="{StaticResource Text.TitleLarge}">
        <Setter Property="FontSize" Value="14" /><Setter Property="LineHeight" Value="20" />
    </Style>
    <Style x:Key="Text.BodyLarge" TargetType="TextBlock" BasedOn="{StaticResource Text.TitleLarge}">
        <Setter Property="FontSize" Value="16" /><Setter Property="FontWeight" Value="Normal" /><Setter Property="LineHeight" Value="24" />
    </Style>
    <Style x:Key="Text.BodyMedium" TargetType="TextBlock" BasedOn="{StaticResource Text.BodyLarge}">
        <Setter Property="FontSize" Value="14" /><Setter Property="LineHeight" Value="21" />
    </Style>
    <Style x:Key="Text.BodySmall" TargetType="TextBlock" BasedOn="{StaticResource Text.BodyLarge}">
        <Setter Property="FontSize" Value="12" /><Setter Property="LineHeight" Value="17" />
    </Style>
    <Style x:Key="Text.LabelLarge" TargetType="TextBlock" BasedOn="{StaticResource Text.TitleLarge}">
        <Setter Property="FontSize" Value="14" /><Setter Property="LineHeight" Value="20" />
    </Style>
    <Style x:Key="Text.LabelMedium" TargetType="TextBlock" BasedOn="{StaticResource Text.TitleLarge}">
        <Setter Property="FontSize" Value="12" /><Setter Property="LineHeight" Value="16" />
    </Style>
    <Style x:Key="Text.LabelSmall" TargetType="TextBlock" BasedOn="{StaticResource Text.TitleLarge}">
        <Setter Property="FontSize" Value="11" /><Setter Property="LineHeight" Value="14" />
    </Style>
</ResourceDictionary>
