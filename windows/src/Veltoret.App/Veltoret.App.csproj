<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Windows 10 2004+ (toast notifications, media transport controls, speech). -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>Veltoret.App</RootNamespace>
    <AssemblyName>Veltoret</AssemblyName>
    <Product>Veltoret</Product>
    <Version>1.1.2</Version>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <!-- LibVLC's native build is ~150 MB; only ship x64. -->
    <VlcWindowsX86Enabled>false</VlcWindowsX86Enabled>
    <VlcWindowsArm64Enabled>false</VlcWindowsArm64Enabled>
    <!-- Veltoret only plays; it never re-streams or transcodes through LibVLC (casting has its own server). -->
    <VlcWindowsX64ExcludeFiles>plugins\visualization\%2A;plugins\access_output\%2A;plugins\stream_out\%2A</VlcWindowsX64ExcludeFiles>
    <!-- English (US) only: skip the framework's translated resource assemblies. -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <ApplicationIcon>Assets\Veltoret.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Veltoret.Core\Veltoret.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Touch through WM_POINTER instead of the legacy WISP stack: the player's controls live in LibVLCSharp's
         transparent overlay window, and WISP delivers no touches there at all. -->
    <RuntimeHostConfigurationOption Include="Switch.System.Windows.Input.Stylus.EnablePointerSupport" Value="true" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="LibVLCSharp.WPF" Version="3.10.2" />
    <PackageReference Include="Microsoft.Toolkit.Uwp.Notifications" Version="7.1.3" />
    <PackageReference Include="VideoLAN.LibVLC.Windows" Version="3.0.24" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\Fonts\*.ttf" />
    <Resource Include="Assets\Images\**\*" />
    <Resource Include="Assets\Veltoret.ico" />
  </ItemGroup>

</Project>
